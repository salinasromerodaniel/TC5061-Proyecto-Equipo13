# Copiar a .env únicamente si se necesitan cambios a los valores predeterminados.
MIBICI_API_PORT=8014
MIBICI_MLFLOW_PORT=5014
MIBICI_SOURCE_BUNDLE=./models/serving/p1
# Para un clon sin paquete local, indicar el Registry que YA contiene el modelo.
# Desde contenedores, localhost apunta al propio contenedor:
# MIBICI_SOURCE_REGISTRY=http://host.docker.internal:5013
MIBICI_SOURCE_MODEL_NAME=mibici-equipo13-p1-demanda
MIBICI_SOURCE_MODEL_VERSION=1
MIBICI_EXPECTED_MODEL_SHA256=c58b0d4c35c21f2a911ffec551da4234e798dbc96d27f69480fc9db048e00c74
MIBICI_API_CPUS=1.0
MIBICI_API_MEMORY=512m
MIBICI_MLFLOW_CPUS=1.0
MIBICI_MLFLOW_MEMORY=1g
