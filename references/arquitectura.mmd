flowchart LR
  csv["mibici: viajes y catálogo CSV"] --> ingest["mibici.dataset: descarga, normalización y hashes"]
  ingest --> data[("data/processed: Parquet local")]
  ingest --> manifest["references: manifiestos versionados"]
  inegi["inegi: GeoJSON de Zapopan"] --> geo["mibici.geography: punto en polígono"]
  data --> features["mibici.features: estación-semana y retardos"]
  geo --> features
  features --> p1["mibici.modeling.p1: baselines y evaluación temporal"]
  p1 --> tracking["mlflow: SQLite y artefactos locales"]
  p1 --> reports["reports: métricas y figuras"]
  data --> p2panel["mibici.modeling.p2 + p2_panel: flujos semanales, cohorte y horizonte t+1"]
  manifest --> p2panel
  geo --> p2panel
  p2panel --> p2["P2: Dummy y Random Forest; train, validación y prueba temporal"]
  p2 --> tracking
  p2 --> reports
  features -. "integración prevista" .-> others["p3: pendiente de su responsable"]
  classDef pending stroke-dasharray:5 5,fill:#f4f4f4;
